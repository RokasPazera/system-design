@startuml footballManager-current
' footballManager current design (week 5 code, before the redesign).
' Colours: orange = class that changes in the redesign, red = class removed in the redesign.
!pragma layout smetana

skinparam dpi 130
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam nodesep 50
skinparam ranksep 60
hide circle

skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #37474F
  ArrowColor #37474F
  StereotypeFontColor #546E7A
}
skinparam legend {
  BackgroundColor #FFFFFF
  BorderColor #90A4AE
  FontSize 11
}

title footballManager current design

interface "java.lang.Runnable" as Runnable <<interface>> {
  + run(): void
}

class Application #FFE0B2 {
  + scoreTeam1LastMatch: int = 0
  + scoreTeam2LastMatch: int = 0
  + tieScoreLastMatch: boolean = false
  {static} + main(args: String[]): void
  + run(): void
  - findClub(id: int): Club
  - findPlayer(id: int): Player
  - show(): void
  - playMatchBetween2ClubsBasedOnRandomTeamScores(
  {method}     team1: Club, playersTeam1: ArrayList<Player>, keeperTeam1: Player,
  {method}     team2: Club, playersTeam2: ArrayList<Player>, keeperTeam2: Player): Club
  - generateMockData(): void
}

class PriceCalculator #FFCDD2 {
  {static} + calculatePriceClub(club: Club): int
  {static} + calculatePricePlayer(player: Player): int
}

class Club #FFE0B2 {
  - clubId: int
  + timesInspected: int = 0
  + Club(clubId: int)
  + addPlayer(player: Player): void
  + setKeeper(player: Player): void
  + getClubId(): int
  + toString(): String
  + getPlayers(): ArrayList<Player>
  + getKeeper(): Player
}

class Player #FFE0B2 {
  {static} + LASTID_USED: int = 0
  - id: int
  - offensiveLeftSkill: int
  - offensiveRightSkill: int
  - midRightSkill: int
  - midLeftSkill: int
  - defensiveLeftSkill: int
  - defensiveRightSkill: int
  - keeperSkills: int
  + Player(offensiveLeftSkill: int, offensiveRightSkill: int, midRightSkill: int,
  {method}     midLeftSkill: int, defensiveLeftSkill: int, defensiveRightSkill: int, keeperSkills: int)
  + changeStats(offensiveLeftSkill: int, offensiveRightSkill: int, midRightSkill: int,
  {method}     midLeftSkill: int, defensiveLeftSkill: int, defensiveRightSkill: int, keeperSkills: int): void
  + getClub(): Club
  + setClub(club: Club): void
  + getId(): int
  + toString(): String
  + getOffensiveLeftSkill(): int
  + getOffensiveRightSkill(): int
  + getDefensiveLeftSkill(): int
  + getDefensiveRightSkill(): int
  + getKeeperSkills(): int
  + keeperBlockShot(): boolean
  + calculateWinner(application: Application): String
}

Runnable <|.. Application
Application --> "~clubs 0..*" Club
Application ..> PriceCalculator
PriceCalculator ..> Club
PriceCalculator ..> Player
Application --> "0..1" Club : +winnerLastMatch
Club "club 1" -- "players 0..11" Player
Club --> Player : ~keeper 0..1
Application --> "0..*" Player : ~players
Player ..> Application

legend right
  <back:#FFE0B2><color:#FFE0B2>XXXXX</color></back> existing class, changed in the redesign
  <back:#FFCDD2><color:#FFCDD2>XXXXX</color></back> removed in the redesign
endlegend
@enduml
