' Shared look for all UML diagrams in TD 1
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam shadowing false
skinparam backgroundColor #FFFFFF
skinparam roundCorner 6
skinparam ArrowColor #333333
skinparam ArrowFontSize 11
skinparam ArrowFontColor #222222
skinparam NoteBackgroundColor #FFF9E0
skinparam NoteBorderColor #BFA640
skinparam NoteFontSize 11
skinparam ActorBorderColor #333333
skinparam ActorBackgroundColor #FFFFFF
skinparam UsecaseBackgroundColor #EEF3FA
skinparam UsecaseBorderColor #3A5A80
skinparam RectangleBorderColor #333333
skinparam RectangleBackgroundColor #FFFFFF
skinparam NodeBackgroundColor #F4F6F8
skinparam NodeBorderColor #3A4A5C
skinparam ArtifactBackgroundColor #FFFFFF
skinparam ArtifactBorderColor #3A4A5C
skinparam ComponentBackgroundColor #EEF3FA
skinparam ComponentBorderColor #3A5A80
skinparam InterfaceBackgroundColor #FFFFFF
skinparam InterfaceBorderColor #333333
skinparam DatabaseBackgroundColor #EEF3FA
skinparam DatabaseBorderColor #3A5A80
skinparam PackageBorderColor #555555
skinparam PackageBackgroundColor #FFFFFF
skinparam ClassBackgroundColor #F7F9FC
skinparam ClassBorderColor #3A4A5C
skinparam ClassFontStyle bold
skinparam StateBackgroundColor #EEF3FA
skinparam StateBorderColor #3A5A80
skinparam ParticipantBackgroundColor #EEF3FA
skinparam ParticipantBorderColor #3A5A80
skinparam SequenceLifeLineBorderColor #888888
skinparam SequenceGroupBorderColor #666666
skinparam SequenceGroupBackgroundColor #F2F2F2
skinparam SequenceBoxBorderColor #888888
skinparam SequenceDividerBackgroundColor #F2F2F2
skinparam ActivityBackgroundColor #EEF3FA
