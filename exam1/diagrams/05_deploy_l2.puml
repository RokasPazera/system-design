@startuml 05_deploy_l2
!include style.iuml
skinparam nodesep 70
skinparam ranksep 70

node "Account Provider" <<external system>> as ap

node "Player PC\n{OS = Windows 10/11}" <<device>> as pc {
  node "Java 21 runtime\n(bundled with the installer)" <<executionEnvironment>> as pc_rt {
    artifact "game-client.jar" as a_client
  }
}

node "Instance Manager Server" <<device>> as ims {
  node "Java 21 runtime (JVM)" <<executionEnvironment>> as ims_rt {
    artifact "instance-manager.jar" as a_im
  }
}

node "Game Server\n{1..*, auto-scaled}" <<device>> as gs {
  node "Game Instance container\n{0..*, one per instance}" <<executionEnvironment>> as gic #EDE3F5 {
    artifact "game-instance image" as a_gi
  }
}

node "Persistence Server" <<device>> as pss {
  node "Java 21 runtime (JVM)" <<executionEnvironment>> as ps_rt {
    artifact "persistence-service.jar" as a_ps
  }
}

node "Database Server" <<device>> as dbs {
  node "PostgreSQL" <<executionEnvironment>> as pg {
    artifact "player_db" <<schema>> as a_db
  }
}

ap -right- pc : <<HTTPS, OAuth 2.0>>
ap -down- ims : <<HTTPS>>
pc -- ims : <<HTTPS>>
pc -down- gic : <<WebSocket over TLS>>\n0..8 players per instance
ims -right- gs : <<HTTPS>> registry\n<<orchestrator API>> start / stop
gs -down- pss : <<HTTPS>>
pss -right- dbs : <<TCP, SQL>>
@enduml
