@startuml 03_uc_battle
!include style.iuml
left to right direction

actor "Battle Coordinator" as BC

rectangle "Battle Engine" {
  usecase "Start battle" as S
  usecase "Pass turn" as N
  usecase "Get battle log" as L
  usecase "Get battle state" as G
  usecase "Get available actions" as A
  usecase "Apply action" as AA
  usecase "Validate action" as V
}

actor "AI Battle\nController" as ABC
actor "Human Battle\nController" as HBC

BC -- S
BC -- N
BC -- L
BC -- G
G -- ABC
A -- ABC
AA -- ABC
A -- HBC
AA -- HBC

AA .> V : <<include>>
@enduml
